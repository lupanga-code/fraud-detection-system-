  {
   "cell_type": "markdown",
   "id": "b76a600c-550c-407a-a616-af0696c68b7e",
   "metadata": {},
   "source": [
    "# Load and Prepare Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "85c67216-1e28-4a3f-b0c2-c9bd143e95c3",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "\n",
    "# Load dataset\n",
    "df = pd.read_csv(\"synthetic_dataset.csv\")\n",
    "\n",
    "# Convert timestamp to datetime\n",
    "df['Timestamp'] = pd.to_datetime(df['Timestamp'])\n",
    "\n",
    "# Extract time features\n",
    "df['Hour'] = df['Timestamp'].dt.hour\n",
    "df['Day'] = df['Timestamp'].dt.day"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ab7f4fea-04e0-49d9-985a-927e469c43d9",
   "metadata": {},
   "source": [
    "# Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "89207373-a6ff-467c-b708-6cfef1338770",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Flag unusual hours (midnight–5am or late night >10pm)\n",
    "df['UnusualHour'] = df['Hour'].apply(lambda x: 1 if x < 6 or x > 22 else 0)\n",
    "\n",
    "# Transactions per minute per customer\n",
    "df['TxnCountPerMinute'] = df.groupby(['CustomerID','Timestamp'])['TransactionID'].transform('count')\n",
    "\n",
    "# Flag multiple accounts at same time\n",
    "df['MultiAccountFlag'] = df['TxnCountPerMinute'].apply(lambda x: 1 if x > 1 else 0)\n",
    "\n",
    "# Location mismatch (compare with previous transaction location)\n",
    "df['PrevLocation'] = df.groupby('CustomerID')['Location'].shift()\n",
    "df['LocationMismatch'] = (df['Location'] != df['PrevLocation']).astype(int)\n",
    "\n",
    "# Channel switching (compare with previous channel)\n",
    "df['PrevChannel'] = df.groupby('CustomerID')['Channel'].shift()\n",
    "df['ChannelSwitch'] = (df['Channel'] != df['PrevChannel']).astype(int)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0b1ae079-2824-4272-afc0-72751305ff15",
   "metadata": {},
   "source": [
    "# Encode Categorical Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "f7bf2490-6563-43e0-b70b-e9853298fe05",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "# Encode categorical columns\n",
    "for col in ['Merchant','Location','Channel']:\n",
    "    le = LabelEncoder()\n",
    "    df[col] = le.fit_transform(df[col])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ccb5e0db-f320-4c88-9afa-9b835d9aa2f4",
   "metadata": {},
   "source": [
    "# Define Features and Labels"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "ff764d7f-41a3-437c-a95b-3db16361ecbc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Select features for fraud detection\n",
    features = ["Amount", "Merchant", "Location", "Channel", "Hour"]
     X = df[features]
      y = df["FraudFlag"]
       model.fit(X, y)
joblib.dump(model, "fraud_detection_model_simple.pkl")

